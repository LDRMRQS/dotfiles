# GTK3 settings — base do tema + fonte/cursor/ícones. As CORES em si (o que fica vermelho, o que
# fica cinza) vêm do gtk.css ao lado, que sobrescreve as cores nomeadas deste tema-base.
# NÃO editar o arquivo final direto (~/.config/gtk-3.0/settings.ini) — editar este .tmpl.
[Settings]
gtk-application-prefer-dark-theme=true
gtk-theme-name=Adwaita-dark
gtk-icon-theme-name=Papirus-Dark
gtk-cursor-theme-name=Bibata-Modern-Classic
gtk-cursor-theme-size=24
gtk-font-name=JetBrainsMono Nerd Font 11
