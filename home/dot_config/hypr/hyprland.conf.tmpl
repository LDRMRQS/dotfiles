# Hyprland — config gerada pelo chezmoi a partir de .chezmoidata/colors.yaml
# Base: adaptação da config antiga (pasta LDRConfig), ver doc 07 pra detalhe do que mudou e por quê.
# NÃO editar o arquivo final direto (~/.config/hypr/hyprland.conf) — editar este .tmpl e rodar `chezmoi apply`.

#-- Environment Variables & Auto-start ------------------------
# See https://wiki.hyprland.org/Configuring/Environment-variables/
$webBrowser = flatpak run app.zen_browser.zen
$terminal = kitty
$fileManager = thunar

# $menu não é mais usado por nenhum bind (o launcher do Quickshell tomou o lugar do wofi,
# ver bind $mainMod, A abaixo) — `wofi` continua instalado (doc 02) só como fallback manual
# de emergência caso o Quickshell trave; roda-se `wofi -n` na mão se precisar, não tem atalho.
$menu = wofi -n

exec-once = hypridle
exec-once = hyprpaper
exec-once = pypr
# Shell principal: barra + dashboard + launcher + menu de sessão, tudo em QML (base Caelestia
# adaptada pra nossa paleta, ver doc 07). Habilitado agora que os 4 módulos têm implementação
# real (ainda com alguns TODOs pontuais dentro de cada .qml — ver doc 07 "Em aberto").
exec-once = qs

# Autostart de workspace — herdado da config antiga (terminal no ws1, browser no ws2).
# Mantido comentado por padrão; descomente se quiser esse comportamento de volta.
# exec-once = [workspace 1 silent] $terminal
# exec-once = [workspace 2 silent] $webBrowser

env = ELECTRON_OZONE_PLATFORM_HINT,wayland
env = XCURSOR_THEME,Bibata-Modern-Classic
env = XCURSOR_SIZE,24
# QT_QPA_PLATFORMTHEME=gtk2 (não qt6ct!) — decisão do doc 07: Qt widget apps herdam o tema/cores
# GTK diretamente via qt6gtk2, em vez de manter uma paleta Qt separada pra manter em sincronia.
env = QT_QPA_PLATFORMTHEME,gtk2

#-- Output (tela única — painel interno do notebook) -----------
# "preferred,auto,auto" deixa o Hyprland detectar resolução/posição automaticamente.
# Se quiser fixar um nome de saída específico, troca o primeiro campo (ex: eDP-1) depois
# de conferir com `hyprctl monitors`.
monitor = ,preferred,auto,auto

#-- General ----------------------------------------------------
general {
    gaps_in = 2
    gaps_out = 10
    col.active_border = rgba({{ .colors.border_active | trimPrefix "#" }}ee)
    col.inactive_border = rgba({{ .colors.border_inactive | trimPrefix "#" }}aa)
    layout = dwindle
    resize_on_border = true
    allow_tearing = false
}

#-- Decoration -------------------------------------------------
decoration {
    rounding = 10
    active_opacity = 1.0
    inactive_opacity = 0.75
    fullscreen_opacity = 1.0
    blur {
        enabled = true
        size = 3
        passes = 3
        new_optimizations = true
        ignore_opacity = true
        xray = false
        popups = true
        vibrancy = 0.1696
    }
    shadow {
        enabled = true
        range = 15
        render_power = 5
        color = rgba(00000080)
    }
}

#-- Animations -------------------------------------------------
# https://wiki.hyprland.org/Configuring/Variables/#animations
animations {
    enabled = true
    bezier = easeOutQuint,0.23,1,0.32,1
    bezier = fluid, 0.15, 0.85, 0.25, 1
    bezier = snappy, 0.3, 1, 0.4, 1
    animation = border, 1, 5.39, easeOutQuint
    animation = windows, 1, 3, fluid, popin 5%
    animation = windowsOut, 1, 2.5, snappy
    animation = fade, 1, 4, snappy
    animation = workspaces, 1, 1.7, snappy, slide
    animation = specialWorkspace, 1, 4, fluid, slidefadevert -35%
    animation = layers, 1, 2, snappy, popin 70%
}

#-- Miscellaneous ----------------------------------------------
misc {
    disable_hyprland_logo = true
    disable_splash_rendering = false
    vfr = on
    vrr = 1
    mouse_move_enables_dpms = false
    always_follow_on_dnd = true
    layers_hog_keyboard_focus = true
    animate_manual_resizes = false
    disable_autoreload = false
    enable_swallow = false
    focus_on_activate = true
}

#-- Layout: Dwindle ----------------------------------------------
dwindle {
    pseudotile = true
    preserve_split = true
}

#-- Layout: Master -----------------------------------------------
master {
    new_status = master
}

#-- Input: Keyboard, Mouse, Touchpad ------------------------------
input {
    kb_layout = us,br
    kb_variant = ,abnt2
    kb_options = grp:win_space_toggle
    numlock_by_default = false
    repeat_rate = 25
    repeat_delay = 600
    sensitivity = 0
    force_no_accel = true
    follow_mouse = 1
}

#-- Workspace Gestures ---------------------------------------------
gestures {
    workspace_swipe = false
}

#-- Keybindings ------------------------------------------------
# See https://wiki.hyprland.org/Configuring/Keywords/
$mainMod = SUPER

bind = $mainMod, Q, exec, $terminal
bind = $mainMod, C, killactive,
# Antes era `exit` direto (matava a sessão sem confirmação) — agora abre o menu de sessão do
# Quickshell (doc 07: substitui o wlogout antigo), que tem "Sair" como uma das opções.
bind = $mainMod, M, exec, qs ipc call sessionmenu toggle
bind = $mainMod, E, exec, $fileManager
bind = $mainMod, V, togglefloating,
# Launcher completo do Quickshell (doc 07) — $menu/wofi vira só fallback manual (ver acima).
bind = $mainMod, A, exec, qs ipc call launcher toggle
bind = $mainMod, P, pseudo,
bind = $mainMod, s, togglesplit,
bind = $mainMod, F, fullscreen, 0
# Bloqueio manual (não só o timeout do hypridle, doc 07) — mesmo hyprlock.conf.tmpl de sempre,
# só chamado na mão em vez de esperar os 5min de idle.
bind = $mainMod, L, exec, hyprlock

# Printscreen (hyprshot)
bind = , PRINT, exec, hyprshot -m window
bind = shift, PRINT, exec, hyprshot -m region

# Move focus com mainMod + h/j/k/l (vim-like)
bind = $mainMod, h, movefocus, l
bind = $mainMod, j, movefocus, d
bind = $mainMod, k, movefocus, u
bind = $mainMod, l, movefocus, r

# Trocar workspace com mainMod + [0-9]
bind = $mainMod, 1, workspace, 1
bind = $mainMod, 2, workspace, 2
bind = $mainMod, 3, workspace, 3
bind = $mainMod, 4, workspace, 4
bind = $mainMod, 5, workspace, 5
bind = $mainMod, 6, workspace, 6
bind = $mainMod, 7, workspace, 7
bind = $mainMod, 8, workspace, 8
bind = $mainMod, 9, workspace, 9
bind = $mainMod, 0, workspace, 10

# Mover janela ativa pra um workspace com mainMod + SHIFT + [0-9]
bind = $mainMod SHIFT, 1, movetoworkspace, 1
bind = $mainMod SHIFT, 2, movetoworkspace, 2
bind = $mainMod SHIFT, 3, movetoworkspace, 3
bind = $mainMod SHIFT, 4, movetoworkspace, 4
bind = $mainMod SHIFT, 5, movetoworkspace, 5
bind = $mainMod SHIFT, 6, movetoworkspace, 6
bind = $mainMod SHIFT, 7, movetoworkspace, 7
bind = $mainMod SHIFT, 8, movetoworkspace, 8
bind = $mainMod SHIFT, 9, movetoworkspace, 9
bind = $mainMod SHIFT, 0, movetoworkspace, 10

# Scratchpad especial (pyprland cobre os scratchpads "de verdade" — term/music/taskbar, ver pyprland.toml)
bind = $mainMod, R, togglespecialworkspace, magic
bind = $mainMod SHIFT, S, movetoworkspace, special:magic

# Scroll pelos workspaces com mainMod + scroll
bind = $mainMod, mouse_down, workspace, e+1
bind = $mainMod, mouse_up, workspace, e-1

# Mover/redimensionar janelas com mainMod + botão do mouse
bindm = $mainMod, mouse:272, movewindow
bindm = $mainMod, mouse:273, resizewindow

# Redimensionar sem mouse (mainMod SHIFT + h/j/k/l, mesmo esquema vim-like do movefocus acima)
bind = $mainMod SHIFT, h, resizeactive, -40 0
bind = $mainMod SHIFT, l, resizeactive, 40 0
bind = $mainMod SHIFT, k, resizeactive, 0 -40
bind = $mainMod SHIFT, j, resizeactive, 0 40

# Teclas multimídia do notebook (volume/brilho)
bindel = ,XF86AudioRaiseVolume, exec, wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindel = ,XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindel = ,XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindel = ,XF86AudioMicMute, exec, wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindel = ,XF86MonBrightnessUp, exec, brightnessctl s 10%+
bindel = ,XF86MonBrightnessDown, exec, brightnessctl s 10%-

# Controle de mídia (playerctl)
bindl = , XF86AudioNext, exec, playerctl next
bindl = , XF86AudioPause, exec, playerctl play-pause
bindl = , XF86AudioPlay, exec, playerctl play-pause
bindl = , XF86AudioPrev, exec, playerctl previous

#-- Window Rules -----------------------------------------------
# See https://wiki.hyprland.org/Configuring/Window-Rules/
windowrule = suppressevent maximize, class:.*
windowrule = nofocus,class:^$,title:^$,xwayland:1,floating:1,fullscreen:0,pinned:0
